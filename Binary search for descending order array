
#include <stdio.h>

int main() {

    int n, i, target;
    int arr[100];

    printf("Enter array size: ");
    scanf("%d", &n);

    printf("Enter elements in descending order: ");

    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter target value: ");
    scanf("%d", &target);

    int low = 0;
    int high = n - 1;
    int result = -1;

    while (low <= high) {

        int mid = (low + high)  / 2;

        if (arr[mid] == target) {
            result = mid;
            break;
        }

        else if (arr[mid] < target) {
            high = mid - 1;
        }

        else {
            low = mid + 1;
        }
    }

    if (result != -1) {
        printf("Target found at index: %d\n", result);
    }

    else {
        printf("Target not found. Index = -1\n");
    }

    return 0;
}
